# Intelicont - Variables de Entorno
# Para producción, configura estas variables en Vercel.
# Para desarrollo local, copia este archivo a .env.local y completa los valores.

# Supabase / Postgres
# Crea un proyecto en https://supabase.com y copia la Connection String (URI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intelicont"

# Supabase Auth (configurar cuando se cree el proyecto)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
