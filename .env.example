# Intelicont - Variables de Entorno
# Para producción, configura estas variables en Coolify / Vercel.
# Para desarrollo local, copia este archivo a apps/web/.env.local y completa los valores.

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intelicont"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-generated-secret-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# AI Local (Ollama)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Email Transaccional (Resend)
# Si no se define RESEND_API_KEY, los emails se imprimen en consola sin romper el flujo.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="InteliCont <notificaciones@intelicont.com.py>"
