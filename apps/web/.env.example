# Database
DATABASE_URL=postgresql://user:password@localhost:5432/intelicont

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth). Secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SIFEN Integration
SIFEN_API_KEY=your-sifen-api-key

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
SENTRY_DSN=your-sentry-dsn


# AI journal suggestions (human approval always required)
# AI_PROVIDER=rules disables the local model; otherwise rules first, Ollama only when rules are unsure.
AI_PROVIDER=
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:7b: valid JSON 3/3 on the fixture (~15 s warm, CPU); qwen2.5:3b was unbalanced 3/3 (30-53 s).
OLLAMA_MODEL=qwen2.5:7b
