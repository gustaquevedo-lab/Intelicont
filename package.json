{
  "name": "intelicont",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backlog/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @intelicont/web dev",
    "build": "pnpm --filter @intelicont/web build",
    "start": "pnpm --filter @intelicont/web start",
    "lint": "eslint apps/web packages/ledger packages/core",
    "test": "pnpm --filter @intelicont/web test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "pnpm --filter @intelicont/ledger db:seed",
    "db:studio": "drizzle-kit studio",
    "auth:create-user": "pnpm --filter @intelicont/web auth:create-user"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "15.5.15",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "drizzle-orm": "^0.45.2"
  }
}
