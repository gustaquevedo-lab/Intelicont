{
  "name": "intelicont",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backlog/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @intelicont/web dev",
    "build": "pnpm --filter @intelicont/web build",
    "start": "pnpm --filter @intelicont/web start",
    "lint": "pnpm --filter @intelicont/web lint",
    "test": "pnpm --filter @intelicont/web test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "pnpm --filter @intelicont/ledger db:seed",
    "db:seed-auth": "pnpm --filter @intelicont/ledger db:seed-auth",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "dependencies": {
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  }
}
