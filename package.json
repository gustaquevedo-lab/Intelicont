{
  "name": "intelicont",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backlog/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx packages/ledger/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "dotenv -e .env.local -- tsx packages/ledger/db/reset.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  }
}
